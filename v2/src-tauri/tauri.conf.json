{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ling3",
  "version": "2.0.0",
  "identifier": "com.matteo.ling3",
  "build": {
    "beforeDevCommand": {
	"script": "trunk serve",
	"cwd": "../ui" 
    },
    "beforeBuildCommand": {
	"script": "trunk build",
	"cwd": "../ui"
    },
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Ling3",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
